{
  "permissions": {
    "allow": [
      "Bash(python3 infra/operador/vmcmd.py:*)",
      "Bash(python3 infra/operador/buildcmd.py:*)",
      "Bash(python3 infra/operador/mandar_msg.py:*)",
      "Bash(python3 infra/operador/rodar_testes.py:*)",
      "Bash(python3 infra/operador/rodar_testes_pro.py:*)",
      "Bash(python3 infra/operador/resetar_chat.py:*)",
      "Bash(python3 infra/operador/tarefas_auxiliar.py:*)",
      "Bash(python3 infra/operador/resumo_novo.py:*)",
      "Bash(python3 infra/vm/plugins/prospeccao/rodadas.py:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(python3 infra/operador/tarefa_atualizar.py:*)",
      "Bash(python3 infra/operador/implantar.py:*)",
      "Bash(python3 infra/operador/apagar_chat.py:*)",
      "Bash(python3 infra/operador/retomar_chat.py:*)",
      "Bash(python3 infra/operador/aprovar_pendente.py:*)",
      "Bash(python3 infra/operador/decisoes.py:*)",
      "Bash(python3 infra/operador/rotinas.py:*)",
      "Bash(python3 infra/operador/rodar_suites_locais.py:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cerebro_operador.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cerebro_inicio.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.2"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
