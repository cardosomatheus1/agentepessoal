[Unit]
Description=Delegates' isolated boxes (caixa_delegados.py: Hermes/OpenClaw with their tools, apart from the agent)
After=docker.service agentepessoal-firewall.service
Requires=docker.service
[Service]
ExecStart=/usr/bin/python3 /opt/agentepessoal/caixa_delegados.py
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
