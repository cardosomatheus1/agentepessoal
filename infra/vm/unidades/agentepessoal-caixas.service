[Unit]
Description=Guests' isolated boxes (caixa_convidados.py: terminal and files apart from the agent)
After=docker.service agentepessoal-firewall.service
Requires=docker.service
[Service]
ExecStart=/usr/bin/python3 /opt/agentepessoal/caixa_convidados.py
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
