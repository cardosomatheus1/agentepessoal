+# One user-supplied CDP browser serves every conversation and cron job. agent-browser attaches each
+# ``--session`` daemon to the browser's FIRST page and follows any newly created tab, so without this
+# every task drove the same tab (a cron run navigated a conversation's page away mid-challenge). Each
+# owner (a conversation's task_id; a cron JOB, not each run) gets its own tab, created with
+# Target.createTarget in a new window and recorded owner -> targetId in ``browser_own_tabs.json``. Every
+# command is sent as ``batch --bail`` that first selects that tab. The tab outlives the session: the
+# per-turn cleanup and the inactivity reaper only drop the daemon, so the page a human was asked to look
+# at ("Resolver aqui") is still there after the turn ends, and the next turn / cron run adopts it again.
+# Tabs share the browser's default context, so cookies and logins stay shared. Every Hermes process on
+# the same HERMES_HOME (gateway, a second gateway/CLI) shares the registry: it is written under an flock,
+# and an entry a live session holds records that process's pid, so another process neither adopts nor
+# prunes it.
+_own_tab_locks: dict[str, threading.Lock] = {}
+_own_tab_locks_guard = threading.Lock()
+_own_tab_registry_lock = threading.Lock()
+_own_tab_acquire_lock = threading.Lock()  # adopt-or-open is check-then-act across sessions of one owner
+_OWN_TABS_FILE = "browser_own_tabs.json"
+_IDLE_OWN_TABS_KEPT = 6  # idle conversation/subagent tabs kept open (cron job tabs are never pruned)
+
+
+def _own_tab_label(session_info: dict[str, Any]) -> Optional[str]:
+    """Label of this session's own tab on a shared CDP browser; None for every other backend."""
+    if not (session_info.get("features") or {}).get("cdp_override") or not session_info.get("cdp_url"):
+        return None
+    return f"hermes-{session_info['session_name']}"
+
+
+def _tab_owner(task_id: str) -> str:
+    """Who a tab belongs to: every run of one cron job (``cron:<job>:<run>``) reuses that job's tab."""
+    parts = str(task_id or "default").split(":")
+    return f"cron:{parts[1]}" if len(parts) >= 3 and parts[0] == "cron" and parts[1] else str(task_id or "default")
+
+
+def _own_tab_lock(session_info: dict[str, Any]) -> threading.Lock:
+    with _own_tab_locks_guard:
+        return _own_tab_locks.setdefault(session_info["session_name"], threading.Lock())
+
+
+def _own_tabs_path() -> Path:
+    from hermes_constants import get_hermes_home
+    return Path(get_hermes_home()) / _OWN_TABS_FILE
+
+
+def _own_tabs_load() -> dict[str, dict[str, Any]]:
+    try:
+        data = json.loads(_own_tabs_path().read_text(encoding="utf-8"))
+        return {k: v for k, v in data.items() if isinstance(v, dict) and v.get("target_id")} if isinstance(data, dict) else {}
+    except (OSError, ValueError):
+        return {}
+
+
+def _own_tabs_save(data: dict[str, dict[str, Any]]) -> None:
+    path = _own_tabs_path()
+    try:
+        tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+        tmp.write_text(json.dumps(data, indent=1, sort_keys=True), encoding="utf-8")
+        os.replace(tmp, path)
+    except OSError as e:
+        _bt.logger.debug("could not save %s: %s", path, e)
+
+
+@contextlib.contextmanager
+def _own_tabs_locked():
+    """Read-modify-write of the registry, exclusive across threads and across processes."""
+    with _own_tab_registry_lock:
+        try:
+            fh = open(_own_tabs_path().with_name(f".{_OWN_TABS_FILE}.lock"), "a")
+        except OSError:
+            fh = None
+        try:
+            if fh is not None and fcntl is not None:
+                fcntl.flock(fh, fcntl.LOCK_EX)
+            yield
+        finally:
+            if fh is not None:
+                fh.close()
+
+
+def _held_by_other_process(entry: dict[str, Any]) -> bool:
+    """True while the tab is driven by a live session of ANOTHER Hermes process (pid recorded on acquire,
+    cleared on release; a crashed process's pid is dead, so its tab counts as idle again)."""
+    pid = entry.get("holder")
+    if not isinstance(pid, int) or pid <= 0 or pid == os.getpid() or os.name == "nt":
+        return False
+    try:
+        os.kill(pid, 0)
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _own_tab_owner_of(target_id: str) -> Optional[str]:
+    """The owner a Hermes tab was opened for, or None for a tab Hermes did not open."""
+    with _own_tabs_locked():
+        return next((o for o, v in _own_tabs_load().items() if v.get("target_id") == target_id), None)
+
+
+def _tab_held_by_other(target_id: str, session_info: dict[str, Any]) -> bool:
+    with _bt._cleanup_lock:
+        return any(s is not session_info and s.get("tab_target_id") == target_id for s in _bt._active_sessions.values())
+
+
+def _page_targets(cdp_url: str) -> list[dict[str, Any]]:
+    from tools.browser_cdp_tool import _cdp_call, _run_async
+    infos = _run_async(_cdp_call(cdp_url, "Target.getTargets", {}, None, 5.0)).get("targetInfos", [])
+    return [t for t in infos if t.get("type") == "page"]
+
+
+def _tab_ref_for_target(task_id: str, session_info: dict[str, Any], base_parts: list[str], engine: str,
+                        timeout: int, target: dict[str, Any]) -> Optional[str]:
+    """This daemon's ref (``t<N>``) for the page ``target``. agent-browser lists tabs without targetIds:
+    match on the URL; if several tabs share it, a one-off marker set on the target over CDP tells them apart."""
+    listed = _spawn_and_collect(task_id, session_info, base_parts + ["--json", "tab", "list"], "tab", engine, timeout)
+    tabs = ((listed.get("data") or {}).get("tabs") or []) if isinstance(listed, dict) and listed.get("success") else []
+    tabs = [t for t in tabs if t.get("tabId")]
+    same = [t for t in tabs if t.get("url") == target.get("url")]
+    if len(same) == 1:
+        return same[0]["tabId"]
+    from tools.browser_cdp_tool import _cdp_call, _run_async
+    nonce, key = uuid.uuid4().hex, "Symbol.for('hermes.own_tab')"
+    cdp_url, tid = session_info["cdp_url"], target["targetId"]
+    try:
+        _run_async(_cdp_call(cdp_url, "Runtime.evaluate", {"expression": f"window[{key}]='{nonce}'"}, tid, 5.0))
+        for tab in same or tabs:
+            raw = _spawn_and_collect(task_id, session_info, base_parts + ["--json", "batch", "--bail"], "tab", engine,
+                                     timeout, json.dumps([["tab", tab["tabId"]], ["eval", f"String(window[{key}]||'')"]]).encode())
+            if isinstance(raw, list) and len(raw) == 2 and ((raw[1] or {}).get("result") or {}).get("result") == nonce:
+                return tab["tabId"]
+    except Exception as e:
+        _bt.logger.debug("own tab probe for %s failed: %s", tid[:8], e)
+    finally:
+        try:
+            _run_async(_cdp_call(cdp_url, "Runtime.evaluate", {"expression": f"delete window[{key}]"}, tid, 5.0))
+        except Exception:
+            pass
+    return None
+
+
+def _acquire_own_tab(task_id: str, session_info: dict[str, Any], base_parts: list[str], engine: str,
+                     timeout: int) -> Optional[str]:
+    """Bind the session to its owner's tab: adopt the recorded one if it is still open and no other live
+    session drives it, else open a new one (Target.createTarget, own window). Sets ``tab_ref`` (this
+    daemon's id for it) and ``tab_target_id`` (the CDP supervisor attaches to exactly that tab).
+    Returns an error string, or None on success."""
+    from tools.browser_cdp_tool import _cdp_call, _run_async
+    cdp_url = session_info["cdp_url"]
+    owner = _tab_owner(task_id)
+    with _own_tabs_locked():
+        entry = _own_tabs_load().get(owner) or {}
+    pages = {t["targetId"]: t for t in _page_targets(cdp_url)}
+    known = pages.get(entry.get("target_id", ""))
+    if (known is not None and not _tab_held_by_other(known["targetId"], session_info)
+            and not _held_by_other_process(entry)):
+        ref = _tab_ref_for_target(task_id, session_info, base_parts, engine, timeout, known)
+        if ref:
+            session_info.update(tab_ref=ref, tab_target_id=known["targetId"], tab_owner=owner)
+            _own_tabs_touch(owner, known["targetId"])
+            _bt.logger.info("Adopted own browser tab %s (target %s) for task %s", ref, known["targetId"][:8], task_id)
+            return None
+        _bt.logger.warning("Own tab %s of %s is open but agent-browser does not list it; opening another",
