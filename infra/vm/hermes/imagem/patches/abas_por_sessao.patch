+    marker = f"about:blank#{_own_tab_label(session_info)}"
+    try:
+        created = _run_async(_cdp_call(cdp_url, "Target.createTarget",
+                                       {"url": marker, "newWindow": True, "background": True}, None, 10.0))
+    except Exception as e:
+        return f"could not open this session's own browser tab: {e}"
+    target_id = str(created.get("targetId") or "")
+    if not target_id:
+        return "could not open this session's own browser tab: Target.createTarget returned no targetId"
+    ref = None
+    for _ in range(10):
+        ref = _tab_ref_for_target(task_id, session_info, base_parts, engine, timeout,
+                                  {"targetId": target_id, "url": marker})
+        if ref:
+            break
+        time.sleep(0.2)
+    if not ref:
+        _close_tab(cdp_url, target_id)
+        return "could not open this session's own browser tab: agent-browser did not see the new tab"
+    session_info.update(tab_ref=ref, tab_target_id=target_id, tab_owner=owner)
+    _own_tabs_touch(owner, target_id)
+    _bt.logger.info("Opened own browser tab %s (target %s) for task %s", ref, target_id[:8], task_id)
+    return None
+
+
+def _own_tabs_touch(owner: str, target_id: str) -> None:
+    """Record the tab as held by this process (acquire); _release_own_tab rewrites it without a holder."""
+    with _own_tabs_locked():
+        data = _own_tabs_load()
+        data[owner] = {"target_id": target_id, "used": time.time(), "holder": os.getpid()}
+        _own_tabs_save(data)
+
+
+def _close_tab(cdp_url: str, target_id: str) -> None:
+    """Close one tab by targetId; never the browser's last page (a headed Chrome with no window may exit)."""
+    try:
+        from tools.browser_cdp_tool import _cdp_call, _run_async
+        pages = _page_targets(cdp_url)
+        if len(pages) > 1 and any(t.get("targetId") == target_id for t in pages):
+            _run_async(_cdp_call(cdp_url, "Target.closeTarget", {"targetId": target_id}, None, 5.0))
+    except Exception as e:
+        _bt.logger.debug("closing tab %s failed: %s", target_id[:8], e)
+
+
+def _release_own_tab(session_info: dict[str, Any]) -> None:
+    """Session teardown (per-turn cleanup, inactivity reaper, ``close``): the tab stays open for its owner.
+    Only the oldest idle conversation/subagent tabs beyond ``_IDLE_OWN_TABS_KEPT`` are closed; cron job
+    tabs, tabs a live session drives and tabs Hermes did not open are never closed here."""
+    session_info.pop("tab_ref", None)
+    target_id = session_info.pop("tab_target_id", "")
+    owner = session_info.pop("tab_owner", "")
+    cdp_url = session_info.get("cdp_url") or ""
+    if not target_id or not cdp_url:
+        return
+    try:
+        open_ids = {t["targetId"] for t in _page_targets(cdp_url)}
+    except Exception as e:
+        _bt.logger.debug("own tab release: listing tabs failed: %s", e)
+        return
+    with _bt._cleanup_lock:
+        held = {s.get("tab_target_id") for s in _bt._active_sessions.values() if s is not session_info}
+    with _own_tabs_locked():
+        data = {o: v for o, v in _own_tabs_load().items() if v["target_id"] in open_ids}
+        if owner and target_id in open_ids:
+            data[owner] = {"target_id": target_id, "used": time.time()}
+        idle = sorted(((v.get("used", 0), o) for o, v in data.items()
+                       if not o.startswith("cron:") and v["target_id"] not in held
+                       and not _held_by_other_process(v)), reverse=True)
+        doomed = [o for _, o in idle[_IDLE_OWN_TABS_KEPT:]]
+        for o in doomed:
+            _close_tab(cdp_url, data.pop(o)["target_id"])
+        _own_tabs_save(data)
+    if doomed:
+        _bt.logger.info("Closed %d idle own browser tab(s): %s", len(doomed), ", ".join(doomed))
+
+
+def _run_in_own_tab(task_id: str, session_info: dict[str, Any], base_parts: list[str], engine: str,
+                    timeout: int, label: str, command: str, steps: list) -> dict[str, Any]:
+    """Run ``steps`` as ``batch --bail`` after ``tab <ref>``. A failed select means the daemon restarted
+    (refs are per daemon) or the tab was closed: the tab is looked up again by targetId, once."""
+    for attempt in range(2):
+        with _own_tab_lock(session_info), _own_tab_acquire_lock:
+            if not session_info.get("tab_ref"):
+                error = _acquire_own_tab(task_id, session_info, base_parts, engine, timeout)
+                if error:
+                    return {"success": False, "error": error}
+        _cdp._ensure_cdp_supervisor(task_id)
+        payload = json.dumps([["tab", session_info["tab_ref"]], *steps]).encode("utf-8")
+        raw = _spawn_and_collect(task_id, session_info, base_parts + ["--json", "batch", "--bail"],
+                                 command, engine, timeout, payload)
+        if not isinstance(raw, list):
+            return raw  # timeout / transport failure, already shaped
+        if raw and isinstance(raw[0], dict) and not raw[0].get("success"):
+            if attempt:
+                break
+            _bt.logger.info("Own tab %s is no longer known to the agent-browser daemon (task=%s): %s; looking it up again",
+                            session_info.get("tab_ref"), task_id, raw[0].get("error"))
+            _cdp._stop_cdp_supervisor(task_id)
+            with _own_tab_lock(session_info):
+                for key in ("tab_ref", "tab_target_id", "tab_owner"):
+                    session_info.pop(key, None)
+            continue
+        return _unwrap_batch_result(raw[1:], command)
+    return {"success": False, "error": f"Browser command '{command}' could not select this session's own tab"}
